# 本地后端配置：复制本文件为 .env 后填写
DB_URL=jdbc:mysql://localhost:3306/lingani?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=

# 用户登录令牌密钥，至少 32 字节随机字符串
USER_JWT_SECRET=

# Agent 委托令牌密钥，必须与 agent/.env 完全一致
AGENT_JWT_SECRET=

# CycAni 播放源 Token
CYCANI_TOKEN=
