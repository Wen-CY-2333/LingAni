# 复制本文件为 .env 后填写实际值，.env 已被 .gitignore 忽略
# 该文件由 application.yml 的 spring.config.import 自动加载

# ===== 数据库 =====
DB_URL=jdbc:mysql://localhost:3306/lingani?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=你的MySQL密码

# ===== JWT =====
JWT_SECRET=请替换为至少32字节的随机字符串
JWT_EXPIRE_SECONDS=604800

# ===== 跨域 =====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== CycAni 动漫数据接口 =====
# 播放源直链接口 Token（第三方颁发，仅保存在后端）
CYCANI_TOKEN=在此填写播放源 Token
