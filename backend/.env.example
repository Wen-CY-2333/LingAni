# 复制本文件为 .env 后填写实际值，.env 已被 .gitignore 忽略
# 该文件由 application.yml 的 spring.config.import 自动加载

# ===== 数据库 =====
DB_URL=jdbc:mysql://localhost:3306/lingani?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=你的MySQL密码

# ===== 用户登录令牌（USER JWT）=====
# 长期身份凭据：登录后签发，默认 7 天，用于访问全部受保护业务接口
USER_JWT_SECRET=请替换为至少32字节的随机字符串
USER_JWT_ISSUER=lingani
USER_JWT_TTL_SECONDS=604800

# ===== 跨域 =====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== CycAni 动漫数据接口 =====
# 播放源直链接口 Token（第三方颁发，仅保存在后端）
CYCANI_TOKEN=在此填写播放源 Token

# ===== Agent 委托令牌（AGENT JWT）=====
# 短期委托凭据：每次 AI 对话前签发，默认 5 分钟失效，权限仅限 AI 对话与个人数据读取
# 必须与 agent/.env 中的 AGENT_JWT_SECRET 完全一致，至少 32 字节随机字符串
AGENT_JWT_SECRET=请替换为至少32字节的随机字符串
AGENT_JWT_ISSUER=lingani-backend
AGENT_JWT_AUDIENCE=lingani-agent
AGENT_JWT_TTL_SECONDS=300
