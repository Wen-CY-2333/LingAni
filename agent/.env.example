# ===== Agent 服务自身 =====
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
# 允许直接访问 Agent 服务的前端来源（逗号分隔）
AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 模型提供方：deepseek / ollama =====
# 默认使用 DeepSeek API；本地开发时如需离线可用的本地模型，可切换为 ollama
LLM_PROVIDER=deepseek
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60

# ===== DeepSeek（LLM_PROVIDER=deepseek 时使用）=====
DEEPSEEK_API_KEY=替换为你的 DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 本地 Ollama（已保留兼容，不作为默认方案）=====
# 启用前需将 LLM_PROVIDER 改为 ollama，并确保本地 Ollama 服务已启动
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== 灵漫后端（Spring Boot）=====
BACKEND_BASE_URL=http://localhost:8080
BACKEND_TIMEOUT_SECONDS=15

# ===== Agent 委托令牌（AGENT JWT）签名校验 =====
# 短期委托凭据：由后端签发、默认 5 分钟失效，本服务只校验不签发
# 密钥必须与 backend/.env 中的 AGENT_JWT_SECRET 完全一致，至少 32 个字符
AGENT_JWT_SECRET=please-change-me-to-a-random-32-plus-char-secret
AGENT_JWT_ISSUER=lingani-backend
AGENT_JWT_AUDIENCE=lingani-agent
AGENT_JWT_TTL_SECONDS=300

# ===== 会话记忆 =====
AGENT_MAX_HISTORY_MESSAGES=20
