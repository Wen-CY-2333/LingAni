# 本地 Agent 配置：复制本文件为 .env 后填写

# 模型提供方：deepseek / ollama
LLM_PROVIDER=deepseek

# DeepSeek API Key（LLM_PROVIDER=deepseek 时填写）
DEEPSEEK_API_KEY=

# Ollama（LLM_PROVIDER=ollama 时必填，填写实际可访问地址）
# 例：本地 http://localhost:11434；Docker 内连宿主机 http://host.docker.internal:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# Agent 委托令牌密钥，必须与 backend/.env 完全一致
AGENT_JWT_SECRET=
