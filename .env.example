# docker compose 部署配置：复制本文件为 .env 后填写
#   cp .env.example .env && chmod 600 .env
# 随机密钥生成：openssl rand -hex 32
#
# 本文件只放密钥与凭据；端口、模型、数据库地址等非敏感配置
# 已直接写在 docker-compose.yml 中，需要修改时改那里。

# MySQL root 密码（同时作为后端数据库密码）
MYSQL_ROOT_PASSWORD=

# 用户登录令牌密钥（USER JWT），至少 32 字节随机字符串
USER_JWT_SECRET=

# Agent 委托令牌密钥（AGENT JWT），后端与 agent 必须一致，至少 32 字节随机字符串
AGENT_JWT_SECRET=

# CycAni 播放源 Token（后端专用）
CYCANI_TOKEN=

# DeepSeek API Key
DEEPSEEK_API_KEY=
